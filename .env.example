# ============================================
# BASSIR SYSTEM — Environment Variables
# Copy this file to .env.local and fill values
# NEVER commit .env.local to git
# ============================================

# Supabase — get from supabase.com > project > settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site URL
NEXT_PUBLIC_SITE_URL=https://bassir-system.ma

# WhatsApp — phone number for lead notifications (international format no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=212661415578
NEXT_PUBLIC_WHATSAPP_NUMBER_2=212615087213

# Google Search Console API
# Get from Google Cloud Console > APIs > Search Console API
GOOGLE_GSC_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
GOOGLE_GSC_SITE_URL=https://bassir-system.ma

# Admin credentials (set via Supabase Auth)
# Create admin user in Supabase Dashboard > Authentication > Users
# Then set metadata: { "role": "admin" }
ADMIN_EMAIL=admin@bassir-system.ma

# Vercel Analytics — auto-injected by Vercel, no action needed
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=auto

# Optional: Google Tag Manager
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
